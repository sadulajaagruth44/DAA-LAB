//Factorial using Iterative Method
#include <iostream>
using namespace std;

int main()
{
    int n;
    int fact = 1;

    cout << "Enter a number: ";
    cin >> n;

    for(int i = 1; i <= n; i++)
    {
        fact = fact * i;
    }

    cout << "Factorial = " << fact;

    return 0;
}

/*Time Analysis
Time Complexity: O(n)
Space Complexity: O(1)*/

//Factorial using Recursive Method

#include <iostream>
using namespace std;

int factorial(int n)
{
    if(n == 0 || n == 1)
    {
        return 1;
    }

    return n * factorial(n - 1);
}

int main()
{
    int n;

    cout << "Enter a number: ";
    cin >> n;

    cout << "Factorial = " << factorial(n);

    return 0;
}

/*Time Analysis
Time Complexity: O(n)
Space Complexity: O(n) because of recursive function calls.*/
